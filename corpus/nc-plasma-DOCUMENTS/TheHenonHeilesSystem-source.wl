Manipulate[With[{sdata = Reap[NDSolve[{{Derivative[1][Subscript[y, 1]][t] == Mod[Subscript[y, 3][t], 2, -1], Derivative[1][Subscript[y, 2]][t] == Mod[Subscript[y, 4][t], 2, -1], Derivative[1][Subscript[y, 3]][t] == Mod[(-Subscript[y, 1][t])*(1 + 2*Subscript[y, 2][t]), 2, -1], Derivative[1][Subscript[y, 4]][t] == Mod[-Subscript[y, 1][t]^2 + (-1 + Subscript[y, 2][t])*Subscript[y, 2][t], 2, -1]}, {Subscript[y, 1][0] == x0, Subscript[y, 2][0] == y0, Subscript[y, 3][0] == px, Subscript[y, 4][0] == py}}, {Subscript[y, 1][t], Subscript[y, 3][t], Subscript[y, 2][t], Subscript[y, 4][t]}, {t, tf}, Method -> {"EventLocator", "Event" -> Subscript[y, 1][t], "EventAction" :> Sow[{Subscript[y, 2][t], Subscript[y, 4][t], Subscript[y, 3][t]}], "EventLocationMethod" -> "LinearInterpolation", "Method" -> {"SymplecticPartitionedRungeKutta", "DifferenceOrder" -> 4, "PositionVariables" -> {Subscript[y, 1][t], Subscript[y, 2][t]}}}, StartingStepSize -> 0.25, MaxSteps -> Infinity]]}, Labeled[With[{pp = ParametricPlot3D[Evaluate[{Subscript[y, 1][t], Subscript[y, 2][t], Subscript[y, 4][t]} /. First[sdata]], {t, 0, tf}, ViewPoint -> {1, 0, -6}, Boxed -> False, Axes -> False, ImageSize -> 300, SphericalRegion -> True, ColorFunction -> (ColorData["ThermometerColors"][#4] & )]}, Row[{pp, Graphics[If[sdata[[2]] =!= {}, MapThread[{ColorData["ThermometerColors"][#1], Point[#2]} & , {Last /@ sdata[[-1,1]], Most /@ sdata[[-1,1]]}], {}], Axes -> False, Frame -> True, AspectRatio -> 1, ImageSize -> 300]}]], Text[Row[{"energy = ", px^2/2 + py^2/2 + x0^2/2 + x0^2*y0 + y0^2/2 - y0^3/3}]]]], {{tf, 400, Style["t", Italic]}, 4, 3500, Appearance -> "Labeled"}, {{x0, -0.1, Subscript[Style["x", Italic], "0"]}, -0.1, 0.01, Appearance -> "Labeled"}, {{y0, -0.2, Subscript[Style["y", Italic], "0"]}, -0.2, 0.65, Appearance -> "Labeled"}, {{px, 0.257229, Subscript[Style["p", Italic], Style["x", Italic]]}, -0.257229, 0.38, Appearance -> "Labeled"}, {{py, -0.05, Subscript[Style["p", Italic], Style["y", Italic]]}, -0.05, 0.05, Appearance -> "Labeled"}]
