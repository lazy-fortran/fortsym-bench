Clear[F, Fdd, m, ψ1, ψ1d, α, µ]; , Null, F = Tanh[m]; , Null, Fdd = D[F, {m, 2}]; , Null, ψ1 = (-(1/(E^(α*RealAbs[µ])*(2*α))))*(HeavisideTheta[-µ]*Integrate[E^(α*m)*(Fdd/F), {m, -Infinity, µ}, Assumptions -> {µ < 0, α > 0}] + HeavisideTheta[µ]*Integrate[Fdd/F/E^(α*m), {m, µ, Infinity}, Assumptions -> {µ > 0, α > 0}]); , Null, ψ1d = D[ψ1, µ]; , Null, α = 1; , Null, Plot[{ψ1, -LegendreP[1, α, Tanh[µ]]}, {µ, -3, 3}], Null, Plot[{ψ1d}, {µ, -1, 1}]

