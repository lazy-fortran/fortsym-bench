(* Second-order rotational-transform series for a helically corrugated
   magnetic surface.  The calculation separates the geometrical transform
   of the first-order helical field from the axisymmetric field generated by
   the quadratic mean-current pullback. *)

Get[FileNameJoin[{DirectoryName[$InputFileName], "checklib.wl"}]];
figdir = FileNameJoin[{DirectoryName[$InputFileName], "figures"}];

ClearAll[rho, det, displacement, gamma, radialField, psiPrime,
  psiSecond, surfaceResidual];
psiPrime = -rho det[rho];
psiSecond = -det[rho] - rho det'[rho];
gamma[rho_] := displacement[rho] displacement'[rho] +
  displacement[rho]^2 (1 + rho det'[rho]/det[rho])/(2 rho);

(* The surface is r=rho-eps Delta cos(chi)+eps^2 Gamma cos^2(chi).
   This coefficient is the expansion of
   Psi0(r)-eps r f(r) cos(chi)=Psi0(rho). *)
surfaceResidual = FullSimplify[
  psiPrime gamma[rho] + psiSecond displacement[rho]^2/2 +
    displacement[rho] (det[rho] displacement[rho] +
      rho D[det[rho] displacement[rho], rho])];
check["surface series: the second-order corrugation conserves helical flux",
  surfaceResidual == 0];

ClearAll[t, a0, a1, a2, shiftedRadius, seriesIntegrand, secondIntegrand, h];
shiftedRadius = rho - t displacement[rho] + t^2 gamma[rho];
seriesIntegrand = Normal@Series[
    a0[shiftedRadius] + t a1[shiftedRadius] +
      t^2 a2[shiftedRadius], {t, 0, 2}];
secondIntegrand = gamma[rho] a0'[rho] +
  displacement[rho]^2 a0''[rho]/2 -
  displacement[rho] a1'[rho] + a2[rho];
check["field-line series: corrugated-path expansion gives H",
  FullSimplify[Coefficient[seriesIntegrand, t, 2] == secondIntegrand]];

ClearAll[eps, m, n, hCoefficient];
hCoefficient = secondIntegrand;
iotaSeries = Normal@Series[
    1/(m (a0[rho] + eps^2 hCoefficient/2)) - n/m,
    {eps, 0, 2}];
check["field-line series: helical transform correction is -H/(2 m P0^2)",
  FullSimplify[Coefficient[iotaSeries, eps, 2] ==
    -hCoefficient/(2 m a0[rho]^2)]];

ClearAll[source, meanSource, meanBtheta, delta, capR, bz0,
  btheta0, meanBz, detSymbol, a0Symbol, meanA, iota0];
meanSource[rho_] := D[rho source[rho] delta[rho], rho]/(2 rho);
meanBtheta[rho_] := source[rho] delta[rho]/2;
check["mean-current route: the pullback source integrates to the mean poloidal field",
  FullSimplify[D[rho meanBtheta[rho], rho]/rho == meanSource[rho]]];

detSymbol = m btheta0/rho + n bz0/capR;
a0Symbol = bz0/(capR detSymbol);
meanA = FullSimplify[
  meanBz/(capR detSymbol) -
    bz0 (m meanBtheta[rho]/rho + n meanBz/capR)/
      (capR detSymbol^2)];
iota0 = capR btheta0/(rho bz0);
axisymmetricCorrection = FullSimplify[-meanA/(m a0Symbol^2)];
expectedAxisymmetric = capR meanBtheta[rho]/(rho bz0) -
  iota0 meanBz/bz0;
check["mean-field route: transform includes poloidal and axial mean fields",
  FullSimplify[axisymmetricCorrection == expectedAxisymmetric,
    {rho > 0, capR > 0, bz0 != 0, m != 0}]];
check["mean-current route: with no mean axial field the correction is R S Delta/(2 r Bz)",
  FullSimplify[(axisymmetricCorrection /. meanBz -> 0) ==
    capR source[rho] delta[rho]/(2 rho bz0),
    {rho > 0, capR > 0, bz0 != 0, m != 0}]];

(* The total second-order transform is DEFINED as corrugated-path plus
   mean-current pullback; the independent verification of that decomposition
   is the direct full-field trace check "full trace equals helical plus
   mean-current terms" below. *)

(* A normalized analytic Maxwell example.  It is deliberately small and
   smooth: it is a verification fixture, not an AUG equilibrium. *)
ClearAll[x, iotaBackgroundExpr, btheta0Expr, detExpr, uExpr,
  sourceExpr, fExpr, gExpr, hExpr, phaseExpr, deltaExpr, gammaExpr,
  a0Expr, a1Expr, a2Expr, hSeriesExpr, cHelicalExpr, cMeanExpr,
  cTotalExpr, bthetaMeanExpr, psi0Expr, meanFluxExpr, fValue,
  gValue, hValue, btheta0Value, bz0Value, bthetaMeanValue,
  psi0Value, meanFluxValue, cHelical, cMean, cTotal];

mNum = 1;
nNum = 1;
capRNum = 5;
kNum = nNum/capRNum;
iotaBackgroundExpr = -3/4 + 3 x^2/100;
bz0Expr = 1;
btheta0Expr = iotaBackgroundExpr x/capRNum;
detExpr = FullSimplify[mNum btheta0Expr/x + kNum bz0Expr];
uExpr = x^3/100;
sourceExpr = (8 x/3 - kNum^2 x^3/5)/100;
fExpr = FullSimplify[(D[uExpr, x] - x sourceExpr)/mNum];
gExpr = uExpr/x;
hExpr = kNum uExpr/mNum;
phaseExpr = FullSimplify[mNum gExpr/x + kNum hExpr];
deltaExpr = FullSimplify[fExpr/detExpr];
gammaExpr = FullSimplify[deltaExpr D[deltaExpr, x] +
  deltaExpr^2 (1 + x D[detExpr, x]/detExpr)/(2 x)];
a0Expr = FullSimplify[bz0Expr/(capRNum detExpr)];
a1Expr = FullSimplify[(hExpr detExpr - bz0Expr phaseExpr)/
  (capRNum detExpr^2)];
a2Expr = FullSimplify[bz0Expr phaseExpr^2/(capRNum detExpr^3) -
  hExpr phaseExpr/(capRNum detExpr^2)];
hSeriesExpr = FullSimplify[gammaExpr D[a0Expr, x] +
  deltaExpr^2 D[a0Expr, {x, 2}]/2 -
  deltaExpr D[a1Expr, x] + a2Expr];
cHelicalExpr = FullSimplify[-hSeriesExpr/(2 mNum a0Expr^2)];
bthetaMeanExpr = FullSimplify[sourceExpr deltaExpr/2];
cMeanExpr = FullSimplify[capRNum bthetaMeanExpr/(x bz0Expr)];
cTotalExpr = FullSimplify[cHelicalExpr + cMeanExpr];

fValue[y_] := fExpr /. x -> y;
gValue[y_] := gExpr /. x -> y;
hValue[y_] := hExpr /. x -> y;
btheta0Value[y_] := btheta0Expr /. x -> y;
bz0Value[y_] := bz0Expr /. x -> y;
bthetaMeanValue[y_] := bthetaMeanExpr /. x -> y;
cHelical[y_?NumericQ] := N[cHelicalExpr /. x -> y, 30];
cMean[y_?NumericQ] := N[cMeanExpr /. x -> y, 30];
cTotal[y_?NumericQ] := N[cTotalExpr /. x -> y, 30];

check["analytic fixture: prescribed u solves the radial Maxwell equation",
  FullSimplify[D[uExpr, {x, 2}] + D[uExpr, x]/x -
      (mNum^2/x^2 + kNum^2) uExpr ==
    x D[sourceExpr, x] + 2 sourceExpr, x > 0]];

psi0Expr = -(1/4) x^2/(2 capRNum) -
  (3/100) x^4/(4 capRNum);
meanFluxExpr = FullSimplify[-mNum Integrate[bthetaMeanExpr, x] +
  (mNum Integrate[bthetaMeanExpr, x] /. x -> 0)];
psi0Value[y_] := psi0Expr /. x -> y;
meanFluxValue[y_] := meanFluxExpr /. x -> y;
check["analytic fixture: background flux derivative is -r D",
  FullSimplify[D[psi0Expr, x] == -x detExpr]];
check["analytic fixture: mean flux derivative includes the pullback field",
  FullSimplify[D[meanFluxExpr, x] == -mNum bthetaMeanExpr, x > 0]];

ClearAll[transformFor, amplitude, includeMean, rhoValue, startRadius,
  phase, radius];
transformFor[rhoValue_?NumericQ, amplitude_?NumericQ,
    includeMean_] := Module[
  {qValue, backgroundFlux, invariant, radiusOnSurface, zetaAdvance},
  backgroundFlux[y_] := psi0Value[y] +
    If[TrueQ[includeMean], amplitude^2 meanFluxValue[y], 0];
  invariant[y_?NumericQ, ph_?NumericQ] := backgroundFlux[y] -
    amplitude y fValue[y] Cos[ph];
  qValue[y_, ph_] :=
    mNum (btheta0Value[y] + amplitude gValue[y] Cos[ph] +
        If[TrueQ[includeMean], amplitude^2 bthetaMeanValue[y], 0])/y +
      kNum (bz0Value[y] + amplitude hValue[y] Cos[ph]);
  radiusOnSurface[ph_?NumericQ] := radius /. FindRoot[
      invariant[radius, ph] == backgroundFlux[rhoValue],
      {radius, rhoValue}, WorkingPrecision -> 40,
      AccuracyGoal -> 26, PrecisionGoal -> 26];
  zetaAdvance = NIntegrate[
    With[{y = radiusOnSurface[phase]},
      (bz0Value[y] + amplitude hValue[y] Cos[phase])/
        (capRNum qValue[y, phase])], {phase, 0, 2 Pi},
    WorkingPrecision -> 35, AccuracyGoal -> 24, PrecisionGoal -> 22,
    MaxRecursion -> 18];
  2 Pi/(mNum zetaAdvance) - nNum/mNum
  ];

rhoCheck = 1;
amplitudeCheck = 1/500;
iotaZero = transformFor[rhoCheck, 0, False];
iotaPlusHelical = transformFor[rhoCheck, amplitudeCheck, False];
iotaMinusHelical = transformFor[rhoCheck, -amplitudeCheck, False];
iotaPlusFull = transformFor[rhoCheck, amplitudeCheck, True];
iotaMinusFull = transformFor[rhoCheck, -amplitudeCheck, True];
cHelicalDirect = N[(iotaPlusHelical + iotaMinusHelical - 2 iotaZero)/
  (2 amplitudeCheck^2), 16];
cFullDirect = N[(iotaPlusFull + iotaMinusFull - 2 iotaZero)/
  (2 amplitudeCheck^2), 16];
cHelicalSeries = N[cHelical[rhoCheck], 16];
cMeanSeries = N[cMean[rhoCheck], 16];
cTotalSeries = N[cTotal[rhoCheck], 16];

Print["    helical series/direct = ",
  N[{cHelicalSeries, cHelicalDirect}, 10]];
Print["    mean-current coefficient = ", N[cMeanSeries, 10]];
Print["    total series/direct = ", N[{cTotalSeries, cFullDirect}, 10]];

check["numerical field lines: helical series matches direct corrugated trace",
  Abs[cHelicalDirect - cHelicalSeries] < 2 10^-7];
check["numerical field lines: the mean-current term is not the helical geometrical term",
  Abs[cMeanSeries - cHelicalSeries] > 10^-4];
check["numerical field lines: full trace equals helical plus mean-current terms",
  Abs[cFullDirect - cTotalSeries] < 3 10^-7];

styles = {
  Directive[Thick, ColorData[97][1]],
  Directive[Thick, Dashed, ColorData[97][2]],
  Directive[Thick, DotDashed, ColorData[97][4]]};
decompositionFigure = Show[
  Plot[Evaluate[{cHelicalExpr, cMeanExpr, cTotalExpr}], {x, 0.2, 1.8},
    Frame -> True,
    FrameLabel -> {"surface label  \[Rho]/a",
      "coefficient  \[Delta]\[Iota]/\[Epsilon]^2"},
    PlotStyle -> styles, PlotRange -> All,
    PlotLegends -> Placed[{
      "corrugated-path term", "mean-current pullback term", "sum"},
      {0.70, 0.75}], ImageSize -> 500],
  Graphics[{Black, PointSize[0.019], Point[{{rhoCheck, cFullDirect}}]}]];
Export[FileNameJoin[{figdir, "fig_iota_decomposition.pdf"}],
  decompositionFigure];
check["[exists] fig_iota_decomposition exported",
  FileExistsQ[FileNameJoin[{figdir, "fig_iota_decomposition.pdf"}]]];

reportAndExit[];
